{
  "name": "malssiat-promo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "말씨앗 のプロモーション映像（Remotion）",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "net": "node scripts/net.mjs",
    "voice": "node scripts/voice.mjs",
    "music": "node scripts/marks.mjs | python scripts/music.py public/sound && node scripts/marks.mjs install | python scripts/music.py public/sound --music music-install.wav",
    "studio": "remotion studio src/index.ts",
    "stills": "node scripts/stills.mjs out/stills",
    "render": "remotion render src/index.ts Promo out/malssiat-promo.mp4",
    "install-video": "remotion render src/index.ts Install out/malssiat-install.mp4"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.499",
    "@remotion/cli": "4.0.499",
    "@remotion/renderer": "4.0.499",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.499"
  },
  "devDependencies": {
    "@types/react": "^19",
    "esbuild": "0.28.1",
    "typescript": "^5"
  }
}
